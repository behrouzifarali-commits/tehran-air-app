<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F172A"
    android:fillViewport="true"
    android:layoutDirection="rtl">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="پایش هوشمند کیفیت هوای تهران"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متصل به سرور TEPCO Energy"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvAlarmBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ هشدار! شاخص آلودگی از حد مجاز عبور کرد!"
            android:background="#DC2626"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:gravity="center"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="170dp"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/circle_bg"
            android:layout_marginVertical="12dp">

            <TextView
                android:id="@+id/tvAqiValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="54sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC" />

            <TextView
                android:id="@+id/tvAqiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="در حال دریافت..."
                android:textSize="13sp"
                android:textColor="#CBD5E1"
                android:gravity="center"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvServerUpdate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="بروزرسانی سرور: نامشخص"
            android:textColor="#94A3B8"
            android:textSize="13sp"
            android:layout_marginTop="6dp" />

        <TextView
            android:id="@+id/tvServiceState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="وضعیت پایش پس‌زمینه: غیرفعال"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="انتخاب ایستگاه / منطقه تهران:"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinnerStations"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#334155"
                android:paddingHorizontal="8dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="14dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حد مجاز آلارم (عدد شاخص AQI):"
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etThreshold"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#334155"
                android:textColor="#FFFFFF"
                android:textColorHint="#94A3B8"
                android:hint="مثلاً 150"
                android:inputType="number"
                android:gravity="center"
                android:textSize="16sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnStartService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="فعال‌سازی پایش خودکار (هر ۱۰ دقیقه)"
            android:backgroundTint="#10B981"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnStopService"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="قطع صدای آژیر و توقف پایش"
            android:backgroundTint="#EF4444"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnRefreshNow"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="🔄 بروزرسانی دستی همین الان"
            android:backgroundTint="#334155"
            android:textColor="#E2E8F0" />

    </LinearLayout>
</ScrollView>
